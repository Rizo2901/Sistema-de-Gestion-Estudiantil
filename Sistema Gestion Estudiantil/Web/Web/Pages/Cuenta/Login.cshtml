@page
@model Web.Pages.Cuenta.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<section class="vh-100 bg-light">
    <div class="container py-5 h-100">
        <div class="row justify-content-center align-items-center h-100">
            <!-- Imagen ilustrativa -->
            <div class="col-lg-6 d-none d-lg-block text-center">
                <img src="~/static/images/mobile login-pana (1).svg"
                     class="img-fluid" alt="Ilustración de inicio de sesión" style="max-height: 400px;" />
                <p class="text-muted small mt-2">
                   
                </p>
            </div>

            <!-- Formulario -->
            <div class="col-lg-6">
                <div class="card shadow border-0 p-4">
                    <h3 class="mb-4 text-center text-dark fw-bold">Iniciar Sesión</h3>

                    <form method="post" asp-page-handler="Login">
                        <div class="mb-3">
                            <label asp-for="LoginRequest.Identificador" class="form-label"></label>
                            <input asp-for="LoginRequest.Identificador" class="form-control" placeholder="Ingresa tu correo o usuario" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="LoginRequest.Contrasena" class="form-label"></label>
                            <input asp-for="LoginRequest.Contrasena" class="form-control" type="password" placeholder="Ingresa tu contraseña" />
                        </div>

                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-outline-dark btn-lg">Iniciar Sesión</button>
                        </div>
                    </form>


                </div>
            </div>
        </div>
    </div>
</section>
