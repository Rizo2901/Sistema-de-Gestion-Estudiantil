@model List<Abstracciones.Modelos.SeccionesResponse>

<div class="card dashboard-card shadow rounded-4 mb-4 w-100 h-100">
    <div class="card-header bg-primary text-white rounded-top-4">
        <h5 class="mb-0">Secciones</h5>
    </div>
    <div class="card-body p-2" style="max-height: 220px; overflow-y: auto;">
        @if (Model != null && Model.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var seccion in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center rounded-3 mb-1">
                        <span>@seccion.Nombre</span>
                        <span class="badge bg-secondary">@seccion.IdSeccion</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="text-muted text-center">No hay secciones disponibles.</div>
        }
    </div>
</div>

<style>
    .dashboard-card {
        border-radius: 1.5rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10), 0 1.5px 4px rgba(0,0,0,0.08);
        background: #fff;
        transition: box-shadow 0.2s;
    }

        .dashboard-card:hover {
            box-shadow: 0 8px 32px rgba(0,0,0,0.16), 0 3px 8px rgba(0,0,0,0.12);
        }

    .card-header {
        border-top-left-radius: 1.5rem !important;
        border-top-right-radius: 1.5rem !important;
    }

    .list-group-item {
        border-radius: 0.75rem !important;
    }
</style>