<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />

    <!-- AOS Animations -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <nav class="navbar navbar-light bg-gradient-red text-white px-3 shadow-sm">


        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <img src="~/static/images/icons8-colegio-100.svg" alt="Logo" width="40" height="40" class="me-2">
                <a class="navbar-brand" href="#">Sistema Escolar</a>
            </div>
            <div class="d-none d-md-flex">
                <a class="nav-link text-white" href="/Nosotros">Nosotros</a>
                <a class="nav-link text-white" href="/Contacto">Contacto</a>
            </div>
            <button class="navbar-toggler border-0" type="button" id="menuToggle">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <!-- Sidebar -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    <div id="sidebarMenu" class="position-fixed top-0 end-0 bg-white shadow vh-100 p-4 d-flex flex-column bg-soft-red-sidebar justify-content-between"
         style="width: 250px; transform: translateX(100%); transition: transform 0.3s; z-index: 1050;">

        <div>
            <button class="btn-close float-end" id="menuClose"></button>
            <h5 class="mt-5">Menú</h5>
            <ul class="nav flex-column mt-3">
                <li class="nav-item"><a class="nav-link" href="/Nosotros">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="/Contacto">Contacto</a></li>
                <li class="nav-item"><a class="nav-link" href="/Login">Iniciar sesión</a></li>
            </ul>
        </div>
        <div class="border-top pt-3 d-flex align-items-center gap-2">
            <img src="/img/avatar.png" alt="Usuario" class="rounded-circle" width="60" height="60" style="object-fit: cover;">
            <div class="d-flex flex-column">
                <span class="fw-semibold">Juan Pérez</span>
                <small class="text-muted">juanperez@email.com</small>
            </div>
        </div>
    </div>
    <div class="flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


<footer class="bg-dark text-white py-3 my-4 w-100">
    <div class="container">
        <ul class="nav justify-content-center border-bottom pb-3 mb-3">
            <li class="nav-item"><a href="#" class="nav-link px-2 text-white">Home</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-white">Features</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-white">Pricing</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-white">FAQs</a></li>
            <li class="nav-item"><a href="#" class="nav-link px-2 text-white">About</a></li>
        </ul>
        <p class="text-center text-white mb-0">© 2025 Company, Inc</p>
    </div>
</footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- AOS Script and Init -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
