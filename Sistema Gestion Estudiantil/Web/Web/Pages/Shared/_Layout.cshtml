@using Abstracciones.Modelos.Seguridad
@{
    var perfil = await AuthHelper.ObtenerPerfilAsync(Context.Request);
}

@if (perfil != null)
{
    
}
@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString()?.ToLower();
    bool mostrarMenuDashboard = paginaActual != null && paginaActual.StartsWith("/dashboard");
    bool esCategoria = paginaActual != null && paginaActual.StartsWith("/dashboard/categorias/");

    string activeClass(string page) => paginaActual == page.ToLower() ? "fw-bold text-dark" : "text-white";
}
<!DOCTYPE html>
<html lang="es">
<head>
  
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</head>
<body class="d-flex flex-column ">
    <!-- Navbar -->
    <nav class="navbar navbar-light bg-gradient-red text-white px-3 shadow-sm">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/static/images/icons8-colegio-100.svg" alt="Logo" width="40" height="40" class="me-2" />
                    S.G.E
                </a>
            </div>
            <div class="d-none d-md-flex">
                <a class="nav-link text-white" href="/Nosotros">Nosotros</a>
                <a class="nav-link text-white" href="/Contacto">Contacto</a>
            </div>
            <button class="navbar-toggler border-0" type="button" id="menuToggle">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <!-- Sidebar móvil -->
   

    <div id="sidebarMenu" class="position-fixed top-0 end-0 bg-white shadow vh-100 p-4 d-flex flex-column justify-content-between"
         style="width: 250px; transform: translateX(100%); transition: transform 0.3s; z-index: 1050;">
        <div>
            <button class="btn-close float-end" id="menuClose"></button>
            <h5 class="mt-5">Menú</h5>
            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link text-black @(paginaActual == "/nosotros" ? "active" : "")" asp-page="/Nosotros">
                        <i class="bi bi-people-fill me-2"></i>Nosotros
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-black @(paginaActual == "/contacto" ? "active" : "")" asp-page="/Contacto">
                        <i class="bi bi-envelope-fill me-2"></i>Contacto
                    </a>
                </li>
                @if (perfil != null)
                {
                    <li class="nav-item">
                        <a class="nav-link text-black @(paginaActual == "/dashboard/dashboard" ? "active" : "")" asp-page="/Dashboard/Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Cuenta/Logout">
                            <button type="submit" class="nav-link btn btn-link text-black w-100 text-start">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-black @(paginaActual == "/cuenta/login" ? "active" : "")" asp-page="/Cuenta/Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </a>
                    </li>
                }

                
            </ul>
        </div>
        <div style="border-top: 1px solid #ddd; padding-top: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            
            <div>
                @if (perfil != null)
                {
                    <span style="font-weight: 600;">@perfil.NombreUsuario</span>
                
                    <br />
                    <small style="color: gray;">@perfil.CorreoElectronico</small>
                }
                else
                {
                    <span style="font-weight: 600;">Invitado</span>
                
                    <br />
                    <small style="color: gray;">Sin sesión</small>
                }
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="flex-grow-1">
        <main role="main" style="min-height: 80vh;">
            @if (mostrarMenuDashboard)
            {
                <div style="display: flex; gap: 1rem; position: relative;">

                    <!-- Botón visible solo cuando el submenú está oculto -->
                    <button id="toggleSidebarBtnFixed" class="btn btn-sm btn-light text-dark"
                            style="margin: 1rem; display: none;">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <!-- Submenú Dashboard -->
                    <nav id="submenuDashboard"
                         style="background-color: #343a40; padding: 1rem; width: 220px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="text-white mb-0">Panel</h5>
                            <!-- Botón junto al título -->
                            <button id="toggleSidebarBtn" class="btn btn-sm btn-light text-dark">
                                <i id="toggleIcon" class="bi bi-chevron-left"></i>
                            </button>
                        </div>
                        <ul class="nav flex-column">
                            <!-- Común para todos -->
                            <li class="nav-item">
                                <a class="nav-link text-white @(paginaActual == "/dashboard" ? "fw-bold" : "")"
                                   asp-page="/Dashboard/Dashboard">
                                    <i class="bi bi-house me-2"></i>Inicio
                                </a>
                            </li>


                            @if (perfil?.TipoEntidad == "Administrador")
                            {
                                <!-- Opciones generales para administrador -->
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/estudiantes/index"))" asp-page="/Dashboard/Estudiantes/Index"><i class="bi bi-person-lines-fill me-2"></i>Estudiantes</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/estudiantes/reporteria/index"))" asp-page="/Dashboard/Estudiantes/Reporteria/Index"><i class="bi bi-heart-pulse me-2"></i>Reporteria</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/calificaciones/index"))" asp-page="/Dashboard/Calificaciones/Index"><i class="bi bi-heart-pulse me-2"></i>Calificaciones</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/atencionesmedicas/index"))" asp-page="/Dashboard/AtencionesMedicas/Index"><i class="bi bi-heart-pulse me-2"></i>AtencionesMedicas</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/profesores/index"))" asp-page="/Dashboard/Profesores/Index"><i class="bi bi-person-lines-fill me-2"></i>Profesores</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/roles/index"))" asp-page="/Dashboard/Roles/Index"><i class="bi bi-person-gear me-2"></i>Roles</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/usuarios"))" asp-page="/Dashboard/Usuarios"><i class="bi bi-people-fill me-2"></i>Usuarios</a></li>

                                <!-- Categorías -->
                                <li class="nav-item">
                                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                                       data-bs-toggle="collapse"
                                       href="#submenuCategorias"
                                       role="button"
                                       aria-expanded="@(esCategoria.ToString().ToLower())"
                                       aria-controls="submenuCategorias">
                                        <span><i class="bi bi-tags me-2"></i>Categorías</span>
                                        <i class="bi @(esCategoria ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </a>
                                    <div class="collapse @(esCategoria ? "show" : "")" id="submenuCategorias">
                                        <ul class="nav flex-column ms-3">
                                            <li class="nav-item">
                                                <a class="nav-link @(activeClass("/dashboard/categorias/categoriasalergias/index"))"
                                                   asp-page="/Dashboard/Categorias/CategoriasAlergias/Index">
                                                    <i class="bi bi-caret-right-fill me-2"></i>Categorías Alergias
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link @(activeClass("/dashboard/categorias/categoriasdiscapacidades/index"))"
                                                   asp-page="/Dashboard/Categorias/CategoriasDiscapacidades/Index">
                                                    <i class="bi bi-caret-right-fill me-2"></i>Categorías Discapacidad
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link @(activeClass("/dashboard/categorias/categoriascondicionesespeciales/index"))"
                                                   asp-page="/Dashboard/Categorias/CategoriasCondicionesEspeciales/Index">
                                                    <i class="bi bi-caret-right-fill me-2"></i>Categorías Condiciones Especiales
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link @(activeClass("/dashboard/categorias/categoriassituacionesfamiliares/index"))"
                                                   asp-page="/Dashboard/Categorias/CategoriasSituacionesFamiliares/Index">
                                                    <i class="bi bi-caret-right-fill me-2"></i>Categoría Situación Familiar
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </li>

                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/atencionesmedicas"))" asp-page="/Dashboard/AtencionesMedicas"><i class="bi bi-heart-pulse me-2"></i>Atenciones médicas</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/adaptacionescurriculares/index"))" asp-page="/Dashboard/AdaptacionesCurriculares/Index"><i class="bi bi-heart-pulse me-2"></i>Adaptaciones Curriculares</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/secciones/index"))" asp-page="/Dashboard/Secciones/Index"><i class="bi bi-diagram-3 me-2"></i>Secciones</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/materias/index"))" asp-page="/Dashboard/Materias/Index"><i class="bi bi-card-list me-2"></i>Materias</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/horarios/index"))" asp-page="/Dashboard/Horarios/Index"><i class="bi bi-card-list me-2"></i>Horarios</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/documentos/index"))" asp-page="/Dashboard/Documentos/Index"><i class="bi bi-file-earmark me-2"></i>Documentos</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/condicionesespeciales/index"))" asp-page="/Dashboard/CondicionesEspeciales/Index"><i class="bi bi-person-lines-fill me-2"></i>Condiciones Especiales</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/familiares/index"))" asp-page="/Dashboard/Familiares/Index"><i class="bi bi-building me-2"></i>Padres de familia</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesfamiliares/index"))" asp-page="/Dashboard/ReunionesFamiliares/Index"><i class="bi bi-people me-2"></i>Reuniones familiares</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesadministrativas/index"))" asp-page="/Dashboard/ReunionesAdministrativas/Index"><i class="bi bi-building me-2"></i>Reuniones administrativas</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/actividades/index"))" asp-page="/Dashboard/Actividades/Index"><i class="bi bi-kanban me-2"></i>Actividades</a></li>
                            }
                            else if (perfil?.TipoEntidad == "Estudiante")
                            {
                                <!-- Opciones específicas para estudiante -->
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/missecciones"))" asp-page="/Dashboard/MisSecciones"><i class="bi bi-person-badge me-2"></i>Mi sección</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/mishorarios"))" asp-page="/Dashboard/MisHorarios"><i class="bi bi-clock-history me-2"></i>Mis horarios</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/mismaterias"))" asp-page="/Dashboard/MisMaterias"><i class="bi bi-card-list me-2"></i>Mis materias</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/misnotas"))" asp-page="/Dashboard/MisNotas"><i class="bi bi-journal-check me-2"></i>Mis notas</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/actividades/index"))" asp-page="/Dashboard/Actividades/Index"><i class="bi bi-kanban me-2"></i>Actividades</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/misdocumentos"))" asp-page="/Dashboard/MisDocumentos"><i class="bi bi-file-earmark me-2"></i>Mis documentos</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesfamiliares/index"))" asp-page="/Dashboard/ReunionesFamiliares/Index"><i class="bi bi-people me-2"></i>Mis reuniones familiares</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesadministrativas/index"))" asp-page="/Dashboard/ReunionesAdministrativas/Index"><i class="bi bi-building me-2"></i>Mis reuniones administrativas</a></li>
                            }
                            else if (perfil?.TipoEntidad == "Profesor")
                            {
                                <!-- Opciones específicas para profesor -->
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/missecciones"))" asp-page="/Dashboard/MisSecciones"><i class="bi bi-person-badge me-2"></i>Mis secciones</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/mismaterias"))" asp-page="/Dashboard/MisMaterias"><i class="bi bi-card-list me-2"></i>Mis materias</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesfamiliares/index"))" asp-page="/Dashboard/ReunionesFamiliares/Index"><i class="bi bi-people me-2"></i>Reuniones familiares</a></li>
                                <li class="nav-item"><a class="nav-link @(activeClass("/dashboard/reunionesadministrativas/index"))" asp-page="/Dashboard/ReunionesAdministrativas/Index"><i class="bi bi-building me-2"></i>Reuniones administrativas</a></li>
                            }
                        </ul>
                    </nav>

                    <!-- Contenido de la página -->
                    <section class="flex-grow-1" style="padding: 1rem">
                        @RenderBody()
                    </section>

                </div>
            }
            else
            {
                @RenderBody()
            }

        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white py-3 w-100">
        <div class="container">
            <ul class="nav justify-content-center border-bottom pb-3 mb-3">
                <li class="nav-item"><a asp-area="" asp-page="/Index" class="nav-link px-2 text-white">Inicio</a></li>
                <li class="nav-item"><a href="#" class="nav-link px-2 text-white">Contacto</a></li>
                <li class="nav-item"><a href="#" class="nav-link px-2 text-white">Nosotros</a></li>
                <li class="nav-item"><a href="#" class="nav-link px-2 text-white">FAQs</a></li>
                <li class="nav-item"><a href="#" class="nav-link px-2 text-white">About</a></li>
            </ul>
            <p class="text-center text-white mb-0">© 2025 Sistema de Gestión Estudiantil (S.G.E), Inc</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init();

        function toggleSubmenu() {
            const submenu = document.getElementById("submenuDashboard");
            const icon = document.getElementById("toggleIcon");
            if (submenu.style.display === "none") {
                submenu.style.display = "block";
                icon.className = "bi bi-chevron-left";
            } else {
                submenu.style.display = "none";
                icon.className = "bi bi-chevron-right";
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


