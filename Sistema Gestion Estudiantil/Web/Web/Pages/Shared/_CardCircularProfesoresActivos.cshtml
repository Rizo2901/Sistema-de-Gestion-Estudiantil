@model int

@{
    var maxProfesores = 100; // Ajusta según tu lógica
    var porcentaje = Model * 100 / maxProfesores;
    var dasharray = 345 * porcentaje / 100.0;
}

<div class="card dashboard-card shadow rounded-4 mb-4 w-100 h-100">
    <div class="card-body d-flex flex-column justify-content-center align-items-center">
        <h6 class="mb-3">Profesores Activos</h6>
        <div class="progress-circle" style="width: 90px; height: 90px;">
            <svg width="90" height="90">
                <circle cx="45" cy="45" r="40" fill="none" stroke="#e9ecef" stroke-width="8" />
                <circle cx="45" cy="45" r="40" fill="none" stroke="#007bff" stroke-width="8"
                        stroke-dasharray="@dasharray,345"
                        stroke-linecap="round"
                        style="transition: stroke-dasharray 1s;" />
                <text x="45" y="55" text-anchor="middle" font-size="20" fill="#007bff">@Model</text>
            </svg>
        </div>
        <div class="mt-2 text-muted" style="font-size: 0.9em;">Máximo: @maxProfesores</div>
    </div>
</div>

<style>
    .dashboard-card {
        border-radius: 1.5rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10), 0 1.5px 4px rgba(0,0,0,0.08);
        background: #fff;
        transition: box-shadow 0.2s;
    }

        .dashboard-card:hover {
            box-shadow: 0 8px 32px rgba(0,0,0,0.16), 0 3px 8px rgba(0,0,0,0.12);
        }

    .card-header {
        border-top-left-radius: 1.5rem !important;
        border-top-right-radius: 1.5rem !important;
    }

    .list-group-item {
        border-radius: 0.75rem !important;
    }
</style>