@page
@model Web.Pages.Dashboard.Categorias.CategoriasAlergias.IndexModel
@{
    ViewData["Title"] = "Categorías de Alergias";
    Layout = "_Layout";
}

@if (Model.Categorias == null || !Model.Categorias.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay categorías registradas.
    </div>
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <!-- Botón Crear -->
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Categoría
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <!-- Botón Crear -->
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Categoría
                </button>
            </div>
        </div>

        <h2 class="mb-4 text-center text-md-start">Listado de Categorías de Alergias</h2>
        <div class="container-fluid px-0">
            <div class="d-flex flex-column gap-3">
                @foreach (var categoria in Model.Categorias)
                {
                    <div class="bg-white shadow rounded p-3 mx-2">
                        <div class="row align-items-center gy-3">
                            <div class="col flex-grow-1">
                                <h6 class="mb-1 fw-bold">@categoria.Nombre</h6>
                                <p class="mb-0 text-muted">@categoria.Descripcion</p>
                            </div>

                            <!-- Acciones -->
                            <div class="col-12 col-md-auto d-flex flex-wrap gap-2 justify-content-md-end mt-2 mt-md-0">
                                <button class="btn btn-outline-success btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEditar_@categoria.IdCategoria" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEliminar_@categoria.IdCategoria" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Editar -->
                    <div class="modal fade" id="modalEditar_@categoria.IdCategoria" tabindex="-1" aria-labelledby="modalEditarLabel_@categoria.IdCategoria" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 shadow">
                                <form method="post" asp-page-handler="Editar">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title" id="modalEditarLabel_@categoria.IdCategoria">Editar Categoría</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="IdCategoria" value="@categoria.IdCategoria" />
                                        <div class="mb-3">
                                            <label for="Nombre_@categoria.IdCategoria" class="form-label">Nombre</label>
                                            <input type="text" class="form-control" id="Nombre_@categoria.IdCategoria" name="Nombre" value="@categoria.Nombre" required />
                                        </div>
                                        <div class="mb-3">
                                            <label for="Descripcion_@categoria.IdCategoria" class="form-label">Descripción</label>
                                            <textarea class="form-control" id="Descripcion_@categoria.IdCategoria" name="Descripcion" required>@categoria.Descripcion</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Eliminar -->
                    <div class="modal fade" id="modalEliminar_@categoria.IdCategoria" tabindex="-1" aria-labelledby="modalEliminarLabel_@categoria.IdCategoria" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 shadow">
                                <form method="post" asp-page-handler="Eliminar">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title" id="modalEliminarLabel_@categoria.IdCategoria">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>¿Seguro que deseas eliminar la categoría <strong>@categoria.Nombre</strong>?</p>
                                        <input type="hidden" name="IdCategoria" value="@categoria.IdCategoria" />
                                    </div>
                                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal Crear (fuera del bucle) -->
    <div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow">
                <form method="post" asp-page-handler="Crear">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title" id="modalCrearLabel">Crear Categoría</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="NombreNuevaCategoria" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="NombreNuevaCategoria" name="Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label for="DescripcionNuevaCategoria" class="form-label">Descripción</label>
                            <textarea class="form-control" id="DescripcionNuevaCategoria" name="Descripcion" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Crear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
