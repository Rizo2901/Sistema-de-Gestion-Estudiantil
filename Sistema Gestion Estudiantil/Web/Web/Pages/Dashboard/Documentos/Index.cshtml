@page
@model Web.Pages.Dashboard.Documentos.IndexModel
@{
    ViewData["Title"] = "Documentos";
    Layout = "_Layout";
}

@if (Model.EstudiantesConDocumentos == null || !Model.EstudiantesConDocumentos.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay documentos registrados.
    </div>
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#agregarModal" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Documento
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#agregarModal" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Documento
                </button>
            </div>
        </div>

        <h2 class="mb-4 text-center text-md-start">Documentos por Estudiante</h2>
        <div class="container-fluid px-0 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="bi bi-funnel-fill me-2"></i>Filtros</h5>
                    <div class="row g-2">
                        <!-- Filtro por nombre -->
                        <div class="col-12 col-md-4">
                            <input type="text" id="filtroNombre" class="form-control" placeholder="Buscar por nombre...">
                        </div>
                        <!-- Filtro por cédula -->
                        <div class="col-12 col-md-4">
                            <input type="text" id="filtroCedula" class="form-control" placeholder="Buscar por cédula...">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid px-0">
            <div class="d-flex flex-column gap-3">
                @foreach (var est in Model.EstudiantesConDocumentos)
                {
                    <div class="bg-white shadow rounded p-3 mx-2 estudiante-card">
                        <!-- Card clickeable -->
                        <div class="row align-items-center gy-3"
                             role="button"
                             data-bs-toggle="collapse"
                             data-bs-target="#documentos_@est.IdEstudiante"
                             aria-expanded="false"
                             aria-controls="documentos_@est.IdEstudiante"
                             style="cursor: pointer;">
                            <div class="col flex-grow-1">
                                <h6 class="mb-1 fw-bold estudiante-nombre">
                                    @($"{est.Nombre} {est.Apellido1} {est.Apellido2}") — Cédula: @est.Cedula
                                </h6>
                            </div>
                            <div class="col-12 col-md-auto d-flex flex-wrap gap-2 justify-content-md-end mt-2 mt-md-0">
                                <span class="text-muted">📂Documentos: @est.Documentos?.Count() </span>
                            </div>
                        </div>

                        <!-- Acordeón de documentos -->
                        <div class="collapse mt-3" id="documentos_@est.IdEstudiante">
                            @if (est.Documentos?.Any() == true)
                            {
                                <ul class="list-group">
                                    @foreach (var doc in est.Documentos)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@doc.TipoDocumento:</strong> @doc.Descripcion<br />
                                                <small class="text-muted">@doc.TipoArchivo</small>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a href="@doc.Archivo" target="_blank" class="btn btn-sm btn-primary">📄 Ver</a>
                                                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar_@doc.IdDocumento" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                                <button class="btn btn-outline-success btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEditar_@doc.IdDocumento" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </div>
                                        </li>

                                        <!-- Modal Eliminar Documento -->
                                        <div class="modal fade" id="modalEliminar_@doc.IdDocumento" tabindex="-1" aria-labelledby="modalEliminarLabel_@doc.IdDocumento" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 shadow">
                                                    <form method="post" asp-page-handler="Eliminar">
                                                        <div class="modal-header border-bottom-0">
                                                            <h5 class="modal-title" id="modalEliminarLabel_@doc.IdDocumento">Confirmar Eliminación</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>¿Estás seguro que deseas eliminar el documento <strong>@doc.TipoDocumento</strong>?</p>
                                                            <input type="hidden" name="IdDocumento" value="@doc.IdDocumento" />
                                                        </div>
                                                        <div class="modal-footer border-top-0 d-flex justify-content-between">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal Editar Documento -->
                                        <div class="modal fade" id="modalEditar_@doc.IdDocumento" tabindex="-1" aria-labelledby="modalEditarLabel_@doc.IdDocumento" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content rounded-4 shadow">
                                                    <form method="post" asp-page-handler="EditarDocumento" asp-route-idDocumento="@doc.IdDocumento" enctype="multipart/form-data">
                                                        <div class="modal-header border-bottom-0">
                                                            <h5 class="modal-title" id="modalEditarLabel_@doc.IdDocumento">Editar Documento</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <input type="hidden" name="documento.IdEstudiante" value="@doc.IdEstudiante" />

                                                            <!-- Campos ocultos para mantener archivo y tipo -->
                                                            <input type="hidden" name="documento.Archivo" value="@doc.Archivo" />
                                                            <input type="hidden" name="documento.TipoArchivo" value="@doc.TipoArchivo" />

                                                            <div class="mb-3">
                                                                <label class="form-label">Tipo de Documento</label>
                                                                <input type="text" name="documento.TipoDocumento" class="form-control" value="@doc.TipoDocumento" required />
                                                            </div>

                                                            <div class="mb-3">
                                                                <label class="form-label">Descripción</label>
                                                                <textarea name="documento.Descripcion" class="form-control" required>@doc.Descripcion</textarea>
                                                            </div>

                                                            @if (!string.IsNullOrEmpty(doc.TipoArchivo))
                                                            {
                                                                <div class="mb-3">
                                                                    <label class="form-label">Archivo actual:</label>
                                                                    <p class="text-muted">📄 @doc.TipoDocumento (@doc.TipoArchivo)</p>
                                                                </div>
                                                            }

                                                            <div class="mb-3">
                                                                <label class="form-label">Actualizar Archivo</label>
                                                                <input type="file" name="ArchivoDocumento" class="form-control" />
                                                                <small class="text-muted">Si no selecciona un nuevo archivo, se mantendrá el actual.</small>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top-0 d-flex justify-content-between">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="alert alert-info">Este estudiante no tiene documentos registrados.</div>
                            }
                        </div>
                    </div>

                    <!-- Modal Crear Documento -->
                    <div class="modal fade" id="agregarModal" tabindex="-1" aria-labelledby="agregarLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content rounded-4 shadow">
                                <form method="post" asp-page-handler="CrearDocumento" enctype="multipart/form-data">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title" id="agregarLabel">Crear Documento para un Estudiante</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <!-- Dropdown para seleccionar el estudiante -->
                                        <div class="mb-3">
                                            <label class="form-label">Seleccionar Estudiante</label>
                                            <select asp-for="estudianteSeleccionado" asp-items="Model.Estudiantes" class="form-select">
                                                <option value="">Seleccione el estudiante del que es pariente el familiar</option>
                                            </select>
                                            <span asp-validation-for="estudianteSeleccionado" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Archivo del Documento</label>
                                            <input type="file" name="ArchivoDocumento" class="form-control" required />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Tipo de Documento</label>
                                            <input type="text" name="documento.TipoDocumento" class="form-control" required />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Descripción</label>
                                            <textarea name="documento.Descripcion" class="form-control" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-success">Guardar Documento</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}



    @foreach (var documento in Model.Documentos)
    {
        

        <!-- Modal Ver Detalles -->
        <div class="modal fade" id="modalVerDetalles_@documento.IdDocumento" tabindex="-1" aria-labelledby="modalVerDetallesLabel_@documento.IdDocumento" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 shadow" style="background-color: #343a40; color: white;">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title" id="modalVerDetallesLabel_@documento.IdDocumento">Detalles del Documento</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>Tipo:</strong> @documento.TipoDocumento</p>
                        <p><strong>Tipo de Archivo:</strong> @documento.TipoArchivo</p>
                        <p><strong>Descripción:</strong> @documento.Descripcion</p>

                        <!-- Mostrar archivo según su tipo -->
                        @if (documento.TipoArchivo == "application/pdf")
                        {
                            <iframe src="data:application/pdf;base64,@documento.Archivo" width="100%" height="500px"></iframe>
                        }
                        else if (documento.TipoArchivo.StartsWith("image/"))
                        {
                            <img src="data:@documento.TipoArchivo;base64,@documento.Archivo" class="img-fluid rounded" alt="Vista previa del documento" />
                        }
                        else
                        {
                            <p class="text-warning">⚠ No se puede mostrar el archivo. Descárguelo para verlo.</p>
                            <a href="data:@documento.TipoArchivo;base64,@documento.Archivo" download="documento_@documento.IdDocumento" class="btn btn-primary">Descargar Archivo</a>
                        }
                    </div>
                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

    


     }


@section Scripts {
    <script>
        function cambiarVista(tipoFiltro, idEstudiante = "") {
            let url = `/Dashboard/Documentos?filtro=` + tipoFiltro;
            if (tipoFiltro === "PorEstudiante" && idEstudiante) {
                url += `&IdEstudiante=` + idEstudiante;
            }
            window.location.replace(url);
        }
    </script>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const filtroNombre = document.getElementById("filtroNombre");
        const filtroCedula = document.getElementById("filtroCedula");

        const tarjetasEstudiantes = document.querySelectorAll(".estudiante-card");

        function aplicarFiltros() {
            const nombre = filtroNombre.value.toLowerCase();
            const cedula = filtroCedula.value.toLowerCase();

            tarjetasEstudiantes.forEach(card => {
                const nombreText = card.querySelector(".estudiante-nombre")?.textContent.toLowerCase() || "";
                const cedulaText = card.querySelector(".estudiante-cedula")?.textContent.toLowerCase() || "";

                const coincideNombre = nombreText.includes(nombre);
                const coincideCedula = cedulaText.includes(cedula);

                if (coincideNombre && coincideCedula) {
                    card.style.display = "";
                } else {
                    card.style.display = "none";
                }
            });
        }

        [filtroNombre, filtroCedula].forEach(input => {
            input.addEventListener("input", aplicarFiltros);
        });
    });
</script>


}