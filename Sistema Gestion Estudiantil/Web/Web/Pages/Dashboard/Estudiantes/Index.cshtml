<script>
      document.addEventListener("DOMContentLoaded", () => {
        const filtroNombre = document.getElementById("filtroNombreEstudiante");
        const filtroTelefono = document.getElementById("filtroTelefonoEstudiante");
        const filtroCedula = document.getElementById("filtroCedulaEstudiante");

        if (!filtroNombre || !filtroTelefono || !filtroCedula) {
            console.warn("Filtros no disponibles en esta vista.");
            return;
        }

        const tarjetasEstudiantes = document.querySelectorAll(".estudiante-card");

        function aplicarFiltros() {
            const nombre = filtroNombre.value.trim().toLowerCase();
            const telefono = filtroTelefono.value.trim().toLowerCase();
            const cedula = filtroCedula.value.trim().toLowerCase();

            tarjetasEstudiantes.forEach(card => {
                const nombreText = card.querySelector(".estudiante-nombre")?.textContent.toLowerCase() || "";
                const telefonoText = card.querySelector(".estudiante-telefono")?.textContent.toLowerCase() || "";
                const cedulaText = card.querySelector(".estudiante-cedula")?.textContent.toLowerCase() || "";

                const coincideNombre = nombreText.includes(nombre);
                const coincideTelefono = telefonoText.includes(telefono);
                const coincideCedula = cedulaText.includes(cedula);

                card.style.display = (coincideNombre && coincideTelefono && coincideCedula) ? "" : "none";
            });
        }

        [filtroNombre, filtroTelefono, filtroCedula].forEach(input => {
            input.addEventListener("input", aplicarFiltros);
        });
    });
</script>
<script>
function mostrarVistaPrevia(input, previewId) {
    if (input.files && input.files[0]) {
        let reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById(previewId).src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>


