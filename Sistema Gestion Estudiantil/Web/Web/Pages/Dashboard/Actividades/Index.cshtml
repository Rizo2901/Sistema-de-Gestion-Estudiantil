@page
@model Web.Pages.Dashboard.Actividades.IndexModel
@{
    ViewData["Title"] = "Actividades";
    Layout = "_Layout";
}

@if (Model.Actividades == null || !Model.Actividades.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay actividades registradas.
    </div>
}

<div class="container-fluid px-0">
    <div class="row mb-3">
        <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
            <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                <i class="bi bi-plus-lg"></i> Crear Actividad
            </button>
        </div>
    </div>
</div>

<h2 class="mb-4 text-center text-md-start">Calendario de Actividades</h2>

<div class="w-100 px-2 px-lg-3 d-flex justify-content-center">
    <div class="bg-white shadow rounded p-3 w-100" style="max-width: 1200px;">
        <div id="calendarioActividades"></div>
    </div>
</div>

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

<!-- FullCalendar -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales/es.global.min.js"></script>

<!-- Estilo -->
<style>
    #calendarioActividades {
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 2px 12px rgba(0, 0, 0, 0.08);
        font-family: 'Poppins', sans-serif;
        overflow-x: auto;
        width: 100%;
        margin: 0 auto;
    }

    .fc-toolbar-title {
        font-size: 1.6rem;
        font-weight: 600;
    }

    .fc-button {
        border-radius: 6px !important;
        padding: 5px 12px !important;
        background-color: #343a40 !important;
        border: none !important;
        font-weight: 500;
        font-size: 0.85rem !important;
        color: #fff !important;
    }

    .fc-button:hover {
        background-color: #23272b !important;
    }

    .fc-event {
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 0.85rem;
        color: #ffffff !important;
        background-color: #198754 !important;
        border: none;
        font-weight: 500;
    }
</style>

<!-- Modal Crear Actividad -->
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="CrearActividad">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalCrearLabel">Crear Actividad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Actividad.Titulo" class="form-label"></label>
                        <input asp-for="Actividad.Titulo" class="form-control" />
                        <span asp-validation-for="Actividad.Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Actividad.Descripcion" class="form-label"></label>
                        <textarea asp-for="Actividad.Descripcion" class="form-control"></textarea>
                        <span asp-validation-for="Actividad.Descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Actividad.Tipo" class="form-label"></label>
                        <input asp-for="Actividad.Tipo" class="form-control" />
                        <span asp-validation-for="Actividad.Tipo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Actividad.Fecha" class="form-label"></label>
                        <input asp-for="Actividad.Fecha" type="date" class="form-control" />
                        <span asp-validation-for="Actividad.Fecha" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Actividad.FechaInicio" class="form-label"></label>
                        <input asp-for="Actividad.FechaInicio" type="time" class="form-control" />
                        <span asp-validation-for="Actividad.FechaInicio" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Actividad.FechaFin" class="form-label"></label>
                        <input asp-for="Actividad.FechaFin" type="time" class="form-control" />
                        <span asp-validation-for="Actividad.FechaFin" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer border-dark">
                    <button type="submit" class="btn btn-dark">Crear Actividad</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var act in Model.Actividades)
{
    <!-- Modal Detalles -->
    <div class="modal fade" id="modalDetalles_@act.IdActividad" tabindex="-1" aria-labelledby="labelDetalles_@act.IdActividad" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="labelDetalles_@act.IdActividad">Detalles de Actividad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Título:</strong> @act.Titulo</p>
                    <p><strong>Descripción:</strong> @act.Descripcion</p>
                    <p><strong>Tipo:</strong> @act.Tipo</p>
                    <p><strong>Inicio:</strong> @act.FechaInicio.ToString("f")</p>
                    <p><strong>Fin:</strong> @act.FechaFin.ToString("f")</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

<!-- Modal Editar Actividad -->
<!-- Modal Editar Actividad -->
<div class="modal fade" id="modalEditar_@act.IdActividad" tabindex="-1" aria-labelledby="labelEditar_@act.IdActividad" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditarActividad">
                <div class="modal-header">
                    <h5 class="modal-title" id="labelEditar_@act.IdActividad">Editar Actividad</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="IdActividad" value="@act.IdActividad" />

                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input type="text" name="Titulo" class="form-control" value="@act.Titulo" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" required>@act.Descripcion</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <input type="text" name="Tipo" class="form-control" value="@act.Tipo" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Fecha</label>
                        <input type="date" name="Fecha" class="form-control" value="@act.FechaInicio.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hora de inicio</label>
                        <input type="time" name="FechaInicio" class="form-control" value="@act.FechaInicio.ToString("HH:mm")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hora de fin</label>
                        <input type="time" name="FechaFin" class="form-control" value="@act.FechaFin.ToString("HH:mm")" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <!-- Modal Eliminar -->
    <div class="modal fade" id="modalEliminar_@act.IdActividad" tabindex="-1" aria-labelledby="labelEliminar_@act.IdActividad" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="EliminarActividad">
                    <div class="modal-header">
                        <h5 class="modal-title" id="labelEliminar_@act.IdActividad">Eliminar Actividad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="IdActividad" value="@act.IdActividad" />
                        <p>¿Estás seguro de que deseas eliminar <strong>@act.Titulo</strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.9.2/umd/popper.min.js"></script>
    <script src="https://unpkg.com/tippy.js@6"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const inicio = document.querySelector("#Actividad_FechaInicio");
        const fin = document.querySelector("#Actividad_FechaFin");

        inicio.addEventListener("change", function () {
            fin.min = inicio.value;
        });
    });
</script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendarioActividades');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: window.innerWidth < 768 ? 'dayGridMonth' : 'timeGridWeek',
                locale: 'es',
                height: 'auto',
                contentHeight: 'auto',
                slotMinTime: "07:00:00",
                slotMaxTime: "20:00:00",
                slotLabelFormat: {
                    hour: 'numeric',
                    minute: '2-digit',
                    hour12: true
                },
                eventTimeFormat: {
                    hour: 'numeric',
                    minute: '2-digit',
                    hour12: true
                },
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                events: [
                    @if (Model.Actividades != null)
                    {
                        foreach (var act in Model.Actividades)
                        {
                            @Html.Raw("{" +
                                $"id: '{act.IdActividad}'," +
                                $"title: '{act.Titulo?.Replace("'", "\\'")}'," +
                                $"start: '{act.FechaInicio:yyyy-MM-ddTHH:mm}'," +
                                $"end: '{act.FechaFin:yyyy-MM-ddTHH:mm}'," +
                                $"description: '{act.Descripcion?.Replace("'", "\\'")}'," +
                                "extendedProps: {" +
                                    $"tipo: '{act.Tipo?.Replace("'", "\\'")}'," +
                                    $"idActividad: '{act.IdActividad}'" +
                                "}" +
                            "},")
                        }
                    }
                ],
                eventDidMount: function (info) {
                    const id = info.event.extendedProps.idActividad;
                    const titulo = info.event.title;
                    const tipo = info.event.extendedProps.tipo;
                    const descripcion = info.event.extendedProps.description;

                    const content = `
                        <strong>${titulo}</strong><br>
                        <em>${tipo}</em><br>
                        ${descripcion}<br><br>
                        <button class="btn btn-sm btn-primary me-1" data-bs-toggle="modal" data-bs-target="#modalEditar_${id}">Editar</button>
<button class="btn btn-sm btn-danger me-1" data-bs-toggle="modal" data-bs-target="#modalEliminar_${id}">Eliminar</button>
<button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#modalDetalles_${id}">Detalles</button>
                    `;

                    tippy(info.el, {
                        content: content,
                        allowHTML: true,
                        theme: 'light-border',
                        interactive: true
                    });
                }
            });

            calendar.render();
        });

        function editarActividad(id) {
            window.location.href = `/Dashboard/Actividades/Editar?id=${id}`;
        }

        function eliminarActividad(id) {
            if (confirm("¿Estás seguro de que deseas eliminar esta actividad?")) {
                window.location.href = `/Dashboard/Actividades/Eliminar?id=${id}`;
            }
        }

        function verDetalles(id) {
            window.location.href = `/Dashboard/Actividades/Detalles?id=${id}`;
        }
    </script>
}