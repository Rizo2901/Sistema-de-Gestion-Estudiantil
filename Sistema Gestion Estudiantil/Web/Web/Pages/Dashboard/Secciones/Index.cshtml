@page
@model Web.Pages.Dashboard.Secciones.IndexModel
@{
    ViewData["Title"] = "Secciones";
    Layout = "_Layout";
}

@if (Model.Secciones == null || !Model.Secciones.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay secciones registradas.
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <!-- Botón que abre el modal de creación -->
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Sección
                </button>
            </div>
        </div>

        <h2 class="mb-4 text-center text-md-start">Listado de Secciones</h2>
        <div class="container-fluid px-0">
            <div class="d-flex flex-column gap-3">
                @foreach (var seccion in Model.Secciones)
                {
                    <div class="bg-white shadow rounded p-3 mx-2">
                        <div class="row align-items-center gy-3">
                            <div class="col flex-grow-1">
                                <h6 class="mb-1 fw-bold">@seccion.Nombre</h6>
                            </div>

                            <!-- Acciones -->
                            <div class="col-12 col-md-auto d-flex flex-wrap gap-2 justify-content-md-end mt-2 mt-md-0">
                                <button class="btn btn-outline-primary btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalDetalles_@seccion.IdSeccion" title="Detalles">
                                    <i class="bi bi-info-circle"></i>
                                </button>
                                <button class="btn btn-outline-success btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEditar_@seccion.IdSeccion" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEliminar_@seccion.IdSeccion" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Editar -->
                    <div class="modal fade" id="modalEditar_@seccion.IdSeccion" tabindex="-1" aria-labelledby="modalEditarLabel_@seccion.IdSeccion" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 shadow">
                                <form method="post" asp-page-handler="Editar">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title" id="modalEditarLabel_@seccion.IdSeccion">Editar Sección</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="IdSeccion" value="@seccion.IdSeccion" />
                                        <div class="mb-3">
                                            <label for="Nombre_@seccion.IdSeccion" class="form-label">Nombre</label>
                                            <input type="text" class="form-control" id="Nombre_@seccion.IdSeccion" name="Nombre" value="@seccion.Nombre" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Eliminar -->
                    <div class="modal fade" id="modalEliminar_@seccion.IdSeccion" tabindex="-1" aria-labelledby="modalEliminarLabel_@seccion.IdSeccion" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 shadow">
                                <form method="post" asp-page-handler="Eliminar">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title" id="modalEliminarLabel_@seccion.IdSeccion">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>¿Estás seguro que deseas eliminar la sección <strong>@seccion.Nombre</strong>?</p>
                                        <input type="hidden" name="IdSeccion" value="@seccion.IdSeccion" />
                                    </div>
                                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal Crear (fuera del bucle) -->
    <div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow">
                <form method="post" asp-page-handler="Crear">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title" id="modalCrearLabel">Crear Sección</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="NombreNuevaSeccion" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="NombreNuevaSeccion" name="Nombre" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Crear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
