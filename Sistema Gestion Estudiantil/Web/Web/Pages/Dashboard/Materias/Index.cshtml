@page
@model Web.Pages.Dashboard.Materias.IndexModel
@{
    ViewData["Title"] = "Materias";
    Layout = "_Layout";
}

@if (Model.Materias == null || !Model.Materias.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay materias registradas.
    </div>
}
else

{
    <div class="container-fluid px-0">
        <div class="row-mb-3">
            <div class="col-12 col d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Materia
                </button>
            </div>
        </div>
    </div>

    <h2 class="mb-4 text-center text-md-start">Listado de Materias</h2>
    <div class="row g-3">
        @foreach (var materia in Model.Materias)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card shadow h-100" style="border-radius: 0 0 1rem 1rem;">
                    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center flex-wrap">
                        <div class="mb-3 mb-md-0">
                            <h5 class="card-title mb-1">Sección: @materia.Nombre</h5>
                        </div>
                        <div class="mb-3 mb-md-0">
                            <h5 class="card-title mb-1">Sección: @materia.Descripcion</h5>
                        </div>
                        <div class="btn-group mt-2 mt-md-0 w-100 w-md-auto">
                            <!-- Botón Editar -->
                            <button type="button"
                                    class="btn btn-sm btn-primary w-100 w-md-auto mb-2 mb-md-0"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEditar_@materia.IdMateria">
                                Editar
                            </button>

                            <!-- Botón Eliminar -->
                            <button type="button"
                                    class="btn btn-sm btn-danger w-100 w-md-auto mb-2 mb-md-0"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar_@materia.IdMateria">
                                Eliminar
                            </button>

                            <a href="#" class="btn btn-sm btn-secondary w-100 w-md-auto">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

}
