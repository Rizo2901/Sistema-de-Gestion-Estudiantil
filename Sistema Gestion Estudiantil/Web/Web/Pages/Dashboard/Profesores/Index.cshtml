@page
@model Web.Pages.Dashboard.Profesores.IndexModel
@{
    ViewData["Title"] = "Profesores";
    Layout = "_Layout";
}

@if (Model.Profesores == null || !Model.Profesores.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay profesores registrados.
    </div>
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Profesor
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#modalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Profesor
                </button>
            </div>
        </div>
    </div>

    <h2 class="mb-4 text-center text-md-start">Listado de Profesores</h2>
    <div class="container-fluid px-0 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-funnel-fill me-2"></i>Filtros</h5>
                <div class="row g-2">
                    <!-- Filtro por nombre -->
                    <div class="col-12 col-md-4">
                        <input type="text" id="filtroNombre" class="form-control" placeholder="Buscar por nombre...">
                    </div>
                    <!-- Filtro por teléfono -->
                    <div class="col-12 col-md-4">
                        <input type="text" id="filtroTelefono" class="form-control" placeholder="Buscar por teléfono...">
                    </div>
                    <!-- Filtro por cédula -->
                    <div class="col-12 col-md-4">
                        <input type="text" id="filtroCedula" class="form-control" placeholder="Buscar por cédula...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-0">
        <div class="d-flex flex-column gap-3">
            @foreach (var profesor in Model.Profesores)
            {
                <div class="bg-white shadow rounded p-3 mx-2 profesor-card">
                    <div class="row align-items-center gy-3">

                        <!-- Info principal -->
                        <div class="col-12 col-md-5">
                            <div class="fw-bold profesor-nombre">@profesor.Nombre @profesor.Apellido1 @profesor.Apellido2</div>
                            <div><i class="bi bi-envelope"></i> @profesor.CorreoElectronico</div>
                            <div class="d-none profesor-cedula">@profesor.Cedula</div>  <!-- oculto para filtro -->
                        </div>

                        <!-- Teléfono centrado -->
                        <div class="col-12 col-md-3 text-md-center profesor-telefono">
                            <i class="bi bi-telephone"></i> @profesor.TelefonoCelular
                        </div>

                        <!-- Acciones al extremo derecho -->
                        <div class="col-12 col-md-4 text-md-end">
                            <div class="d-flex flex-wrap justify-content-start justify-content-md-end gap-1">

                                <!-- Botones principales visibles siempre -->
                                <button class="btn btn-outline-primary btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalDetalles_@profesor.IdProfesor" title="Detalles">
                                    <i class="bi bi-info-circle"></i>
                                </button>
                                <button class="btn btn-outline-success btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEditar_@profesor.IdProfesor" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm square-btn" data-bs-toggle="modal" data-bs-target="#modalEliminarProfesor_@profesor.IdProfesor" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <!-- Acciones menos usadas en dropdown -->
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalAsignarMateria_@profesor.IdProfesor">
                                                <i class="bi bi-journal-plus me-1"></i> Asignar Materia
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalAsignarSeccion_@profesor.IdProfesor">
                                                <i class="bi bi-people-fill me-1"></i> Asignar Sección
                                            </a>
                                        </li>

                                        @if (profesor.IdUsuario == null)
                                        {
                                            <li>
                                                <a class="dropdown-item text-success" data-bs-toggle="modal" data-bs-target="#modalCrearUsuario_@profesor.IdProfesor">
                                                    <i class="bi bi-person-plus-fill me-1"></i> Crear Usuario
                                                </a>
                                            </li>
                                        }
                                        @if (profesor.IdUsuario != null)
                                        {
                                            <li>
                                                <a class="dropdown-item text-primary" href="/Dashboard/Usuarios/Ver?IdUsuario=@profesor.IdUsuario">
                                                    <i class="bi bi-person-check-fill me-1"></i> Ver Usuario
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <a class="dropdown-item" href="/Dashboard/Profesores/VerMaterias?IdProfesor=@profesor.IdProfesor">
                                                <i class="bi bi-eye me-1"></i> Ver Materias
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" href="/Dashboard/Profesores/VerSecciones?IdProfesor=@profesor.IdProfesor">
                                                <i class="bi bi-list-check me-1"></i> Ver Secciones
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>



                <!-- Modal de confirmación para creación de usuario -->
                <div class="modal fade" id="modalCrearUsuario_@profesor.IdProfesor" tabindex="-1"
                     aria-labelledby="modalCrearUsuarioLabel_@profesor.IdProfesor" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-dark text-white">
                                <h5 class="modal-title" id="modalCrearUsuarioLabel_@profesor.IdProfesor">
                                    Crear Usuario para @profesor.Nombre
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body text-start">
                                <p>¿Deseás crear un usuario institucional para <strong>@profesor.Nombre</strong>?</p>
                                <div id="feedbackCrearUsuario_@profesor.IdProfesor"
                                     class="text-center mt-3" style="display:none;">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Enviando...</span>
                                    </div>
                                    <p class="mt-2 text-success fw-bold">Correo enviado con credenciales institucionales</p>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-dark"
                                        onclick="crearUsuarioDesdeEntidad('@profesor.IdProfesor', 'Profesor')"
                                        id="btnCrearUsuario_@profesor.IdProfesor">
                                    Crear y Enviar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="modal fade" id="modalEliminarProfesor_@profesor.IdProfesor" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <form method="post" asp-page-handler="EliminarProfesor">
                            <div class="modal-content p-3">
                                <div class="modal-header">
                                    <h5 class="modal-title">Eliminar Profesor</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p>¿Estás seguro de que deseas eliminar a <strong>@profesor.Nombre @profesor.Apellido1</strong>?</p>
                                   
                                    <input type="hidden" name="Id" value="@profesor.IdProfesor" />
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>



                <div class="modal fade" id="modalDetalles_@profesor.IdProfesor" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Detalles del Profesor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>Nombre:</strong> @profesor.Nombre @profesor.Apellido1 @profesor.Apellido2</p>
                                <p><strong>Correo:</strong> @profesor.CorreoElectronico</p>
                                <p><strong>Dirección:</strong> @profesor.Direccion</p>
                                <p><strong>Teléfono:</strong> @profesor.TelefonoCelular</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="modalEditar_@profesor.IdProfesor" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title">Editar Profesor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <form method="post" asp-page-handler="EditarProfesor">
                                    <input type="hidden" name="IdProfesor" value="@profesor.IdProfesor" />
                                    <div class="mb-3">
                                        <label class="form-label">Nombre</label>
                                        <input type="text" name="Nombre" class="form-control" value="@profesor.Nombre" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Apellido 1</label>
                                        <input type="text" name="Apellido1" class="form-control" value="@profesor.Apellido1" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Apellido 2</label>
                                        <input type="text" name="Apellido2" class="form-control" value="@profesor.Apellido2" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Cedula de Identificación</label>
                                        <input type="text" name="Cedula" class="form-control" value="@profesor.Cedula" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Correo</label>
                                        <input type="email" name="CorreoElectronico" class="form-control" value="@profesor.CorreoElectronico" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Teléfono</label>
                                        <input type="text" name="TelefonoCelular" class="form-control" value="@profesor.TelefonoCelular" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Dirección</label>
                                        <textarea name="Direccion" class="form-control">@profesor.Direccion</textarea>
                                    </div>
                                    <button type="submit" class="btn btn-success">Guardar cambios</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="modal fade" id="modalAsignarMateria_@profesor.IdProfesor" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-secondary text-white">
                                <h5 class="modal-title">Asignar Materia al Profesor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form method="post" asp-page-handler="AsignarMateria">
                                <div class="modal-body">
                                    <input type="hidden" name="IdProfesor" value="@profesor.IdProfesor" />
                                    <div class="mb-3">
                                        <label class="form-label">Materia</label>
                                        <select asp-for="materiaSeleccionada" asp-items="Model.Materias" class="form-control">
                                            <option value="">Seleccione una materia</option>
                                        </select>
                                        <span asp-validation-for="materiaSeleccionada" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-success">Asignar Materia</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>


                <div class="modal fade" id="modalAsignarSeccion_@profesor.IdProfesor" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Asignar Sección al Profesor</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form method="post" asp-page-handler="AsignarSeccion">
                                <div class="modal-body">
                                    <input type="hidden" name="IdProfesor" value="@profesor.IdProfesor" />
                                    <div class="mb-3">
                                        <label class="form-label">Sección</label>
                                        <select asp-for="seccionseleccionada" asp-items="Model.Secciones" class="form-control">
                                            <option value="">Seleccione una sección</option>
                                        </select>
                                        <span asp-validation-for="seccionseleccionada" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-primary">Asignar Sección</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>

    <div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="modalCrearLabel">Crear Profesor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" asp-page-handler="Crear">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="Nombre" name="Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label for="Apellido1" class="form-label">Primer Apellido</label>
                            <input type="text" class="form-control" id="Apellido1" name="Apellido1" required />
                        </div>
                        <div class="mb-3">
                            <label for="Apellido2" class="form-label">Segundo Apellido</label>
                            <input type="text" class="form-control" id="Apellido2" name="Apellido2" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Cedula de Identificación</label>
                            <input type="text" name="Cedula" class="form-control" id="Cedula" />
                        </div>

                        <div class="mb-3">
                            <label for="CorreoElectronico" class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-control" id="CorreoElectronico" name="CorreoElectronico" />
                        </div>
                        <div class="mb-3">
                            <label for="TelefonoCelular" class="form-label">Teléfono Celular</label>
                            <input type="text" class="form-control" id="TelefonoCelular" name="TelefonoCelular" />
                        </div>
                        <div class="mb-3">
                            <label for="Direccion" class="form-label">Dirección</label>
                            <textarea class="form-control" id="Direccion" name="Direccion" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-dark">Crear</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}

@section Scripts {
    <script>
        async function crearUsuarioDesdeEntidad(idEntidad, tipoEntidad) {
            const btn = document.getElementById("btnCrearUsuario_" + idEntidad);
            const feedback = document.getElementById("feedbackCrearUsuario_" + idEntidad);
            btn.disabled = true;
            feedback.style.display = "block";

            const payload = {
                IdEntidad: idEntidad,
                TipoEntidad: tipoEntidad
            };

            try {
                const response = await fetch("/Dashboard/Profesores?handler=CrearUsuarioAuto", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": document.querySelector("input[name='__RequestVerificationToken']").value
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById("modalCrearUsuario_" + idEntidad));
                        modal.hide();
                    }, 2000);
                } else {
                    feedback.innerHTML = `<p class="text-danger fw-bold">Error al crear el usuario.</p>`;
                    btn.disabled = false;
                }
            } catch (error) {
                feedback.innerHTML = `<p class="text-danger fw-bold">Error de conexión.</p>`;
                btn.disabled = false;
            }
        }


    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const filtroNombre = document.getElementById("filtroNombre");
            const filtroTelefono = document.getElementById("filtroTelefono");
            const filtroCedula = document.getElementById("filtroCedula");

            const tarjetasProfesores = document.querySelectorAll(".profesor-card");

            function aplicarFiltros() {
                const nombre = filtroNombre.value.toLowerCase();
                const telefono = filtroTelefono.value.toLowerCase();
                const cedula = filtroCedula.value.toLowerCase();

                tarjetasProfesores.forEach(card => {
                    const nombreText = card.querySelector(".profesor-nombre").textContent.toLowerCase();
                    const telefonoText = card.querySelector(".profesor-telefono").textContent.toLowerCase();
                    const cedulaText = card.querySelector(".profesor-cedula")?.textContent.toLowerCase() || "";

                    const coincideNombre = nombreText.includes(nombre);
                    const coincideTelefono = telefonoText.includes(telefono);
                    const coincideCedula = cedulaText.includes(cedula);

                    if (coincideNombre && coincideTelefono && coincideCedula) {
                        card.style.display = "";
                    } else {
                        card.style.display = "none";
                    }
                });
            }

            [filtroNombre, filtroTelefono, filtroCedula].forEach(input => {
                input.addEventListener("input", aplicarFiltros);
            });
        });
    </script>
    
}
