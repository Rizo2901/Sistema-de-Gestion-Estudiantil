@page
@model Web.Pages.Dashboard.CondicionesEspeciales.IndexModel
@{
    ViewData["Title"] = "Condiciones Especiales";
    Layout = "_Layout";
}

@if (Model.EstudiantesConCondiciones == null || !Model.EstudiantesConCondiciones.Any())
{
    <div class="alert alert-warning" role="alert">
        ⚠️ No hay condiciones especiales registradas.
    </div>
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#ModalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Condición
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-0">
        <div class="row mb-3">
            <div class="col-12 col-md-3 d-flex justify-content-center justify-content-md-end">
                <button class="btn text-white w-100 w-md-auto" data-bs-toggle="modal" data-bs-target="#ModalCrear" style="background-color: #343a40">
                    <i class="bi bi-plus-lg"></i> Crear Condición
                </button>
            </div>
        </div>

        <h2 class="mb-4 text-center text-md-start">Condiciones Especiales por Estudiante</h2>
        <div class="container-fluid px-0 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="bi bi-funnel-fill me-2"></i>Filtros</h5>
                    <div class="row g-2">
                        <!-- Filtro por nombre -->
                        <div class="col-12 col-md-4">
                            <input type="text" id="filtroNombre" class="form-control" placeholder="Buscar por nombre...">
                        </div>
                        <!-- Filtro por cédula -->
                        <div class="col-12 col-md-4">
                            <input type="text" id="filtroCedula" class="form-control" placeholder="Buscar por cédula...">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid px-0">
            <div class="d-flex flex-column gap-3">
                @foreach (var est in Model.EstudiantesConCondiciones)
                {
                    <div class="bg-white shadow rounded p-3 mx-2 estudiante-card">
                        <div class="row align-items-center gy-3"
                             role="button"
                             data-bs-toggle="collapse"
                             data-bs-target="#condiciones_@est.IdEstudiante"
                             aria-expanded="false"
                             aria-controls="condiciones_@est.IdEstudiante"
                             style="cursor: pointer;">
                            <div class="col flex-grow-1">
                                <h6 class="mb-1 fw-bold estudiante-nombre">
                                    @($"{est.Nombre} {est.Apellido1} {est.Apellido2}") — Cédula: <span class="estudiante-cedula">@est.Cedula</span>
                                </h6>
                                <span class="d-none estudiante-cedula">@est.Cedula</span>
                            </div>
                        </div>

                        <!-- Acordeón de condiciones -->
                        <div class="collapse mt-3" id="condiciones_@est.IdEstudiante">
                            @if (est.Condiciones?.Any() == true)
                            {
                                <ul class="list-group">
                                    @foreach (var cond in est.Condiciones)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <strong>Categoría:</strong> @cond.NombreCategoria <br />
                                                <strong>Fecha diagnóstico:</strong> @cond.FechaDiagnostico?.ToShortDateString() <br />
                                                <strong>Observaciones:</strong> @cond.Observaciones
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalEditar_@cond.IdCondicion" title="Editar">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#modalEliminar_@cond.IdCondicion" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </li>


                                        <!-- Modal Eliminar -->
                                        <div class="modal fade" id="modalEliminar_@cond.IdCondicion" tabindex="-1" aria-labelledby="modalEliminarLabel_@cond.IdCondicion" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 shadow">
                                                    <form method="post" asp-page-handler="Eliminar">
                                                        <div class="modal-header border-bottom-0">
                                                            <h5 class="modal-title" id="modalEliminarLabel_@cond.IdCondicion">Confirmar eliminación</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>¿Estás seguro que deseas eliminar la condición <strong>@cond.NombreCategoria</strong>?</p>
                                                            <p>Descripción: <strong>@cond.DescripcionCategoria</strong></p>
                                                            <input type="hidden" name="IdEstudiante" value="@cond.IdEstudiante" />
                                                            <input type="hidden" name="IdCondicion" value="@cond.IdCondicion" />
                                                        </div>
                                                        <div class="modal-footer border-top-0 d-flex justify-content-between">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

<!-- Modal Editar Condición -->
<div class="modal fade" id="modalEditar_@cond.IdCondicion" tabindex="-1" aria-labelledby="modalEditarLabel_@cond.IdCondicion" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <form method="post" asp-page-handler="Editar">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title" id="modalEditarLabel_@cond.IdCondicion">Editar Condición</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="IdCondicion" value="@cond.IdCondicion" />
                    <input type="hidden" name="IdEstudiante" value="@cond.IdEstudiante" />

                    <div class="mb-3">

                        <select name="IdCategoria" class="form-select">
                            <option value="">Seleccione una categoria</option>
                            @foreach (var categoria in Model.Categorias)
                            {
@:                              <option value="@categoria.Value" @(cond.IdCategoria != Guid.Empty && cond.IdCategoria.ToString() == categoria.Value ? "selected" : "")>
@:                                  @categoria.Text
@:                              </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="FechaDiagnostico_@cond.IdCondicion" class="form-label">Fecha Diagnóstico</label>
                        <input type="date" class="form-control" id="FechaDiagnostico_@cond.IdCondicion" name="FechaDiagnostico" value="@cond.FechaDiagnostico?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-3">
                        <label for="Observaciones_@cond.IdCondicion" class="form-label">Observaciones</label>
                        <textarea class="form-control" id="Observaciones_@cond.IdCondicion" name="Observaciones">@cond.Observaciones</textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>


                                    }
                                </ul>


                            }
                            else
                            {
                                <div class="alert alert-info">Este estudiante no tiene condiciones especiales registradas.</div>
                            }
                        </div>
                    </div>


                   

@* 
                    
@* 
                    <!-- Modal Ver Detalles -->
                    <div class="modal fade" id="modalVerDetalles_@condicion.IdCondicion" tabindex="-1" aria-labelledby="modalVerDetallesLabel_@condicion.IdCondicion" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 shadow" style="background-color: #343a40; color: white;">
                                <div class="modal-header border-bottom-0">
                                    <h5 class="modal-title" id="modalVerDetallesLabel_@condicion.IdCondicion">Detalles de la Condición</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <p><strong>Tipo:</strong> @condicion.TipoCondicion</p>
                                    <p><strong>Nombre:</strong> @condicion.NombreCondicion</p>
                                    <p><strong>Fecha Diagnóstico:</strong> @(condicion.FechaDiagnostico.HasValue? condicion.FechaDiagnostico.Value.ToString("yyyy-MM-dd") : "No registrada")</p>
                                    <p><strong>Observaciones:</strong> @condicion.Observaciones</p>
                                </div>
                                <div class="modal-footer border-top-0 d-flex justify-content-between">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div> *@

                 


                }
               


                <!-- Modal para agregar condiciones -->
                <div class="modal fade" id="ModalCrear" tabindex="-1" aria-labelledby="ModalCrearLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content rounded-4 shadow">
                            <form method="post" asp-page-handler="Crear">
                                <div class="modal-header border-bottom-0">
                                    <h5 class="modal-title">Condición Especial</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" id="idCondicion" name="idCondicion" value="@Guid.NewGuid()" />

                                    <div class="mb-3">
                                        <label class="form-label">Seleccionar Estudiante</label>
                                        <select asp-for="estudianteSeleccionado" asp-items="Model.Estudiantes" class="form-select">
                                            <option value="">Seleccione el estudiante al que va registrarle una condición especial</option>
                                        </select>
                                        <span asp-validation-for="estudianteSeleccionado" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Seleccionar Categoría</label>
                                        <select asp-for="categoriaSeleccionada" asp-items="Model.Categorias" class="form-select">
                                            <option value="">Seleccione la categoría de la condición especial del estudiante</option>
                                        </select>
                                        <span asp-validation-for="categoriaSeleccionada" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Fecha Diagnóstico</label>
                                        <input type="date" class="form-control" id="fechaDiagnostico" name="FechaDiagnostico">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Observaciones</label>
                                        <textarea class="form-control" id="observaciones" name="Observaciones"></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer border-top-0 d-flex justify-content-between">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    <button type="submit" class="btn btn-success">Guardar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
              



            </div>
        </div>
    </div>



}






@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const filtroNombre = document.getElementById("filtroNombre");
            const filtroCedula = document.getElementById("filtroCedula");

            if (filtroNombre && filtroCedula) {
                const tarjetasEstudiantes = document.querySelectorAll(".estudiante-card");

                function aplicarFiltros() {
                    const nombre = filtroNombre.value.toLowerCase();
                    const cedula = filtroCedula.value.toLowerCase();

                    tarjetasEstudiantes.forEach(card => {
                        const nombreText = card.querySelector(".estudiante-nombre")?.textContent.toLowerCase() || "";
                        const cedulaText = card.querySelector(".estudiante-cedula")?.textContent.toLowerCase() || "";

                        const coincideNombre = nombreText.includes(nombre);
                        const coincideCedula = cedulaText.includes(cedula);

                        card.style.display = (coincideNombre && coincideCedula) ? "" : "none";
                    });
                }

                [filtroNombre, filtroCedula].forEach(input => {
                    input.addEventListener("input", aplicarFiltros);
                });
            } else {
                console.warn("[Filtros] No se encontraron los campos de filtro en esta vista.");
            }
        });
    </script>


}