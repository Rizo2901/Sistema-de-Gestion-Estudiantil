@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4300">

    <!-- Indicadores -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>

    <!-- Slides -->
    <div class="carousel-inner" style="height: 90vh;">
        <div class="carousel-item active">
            <img src="~/static/images/_a5a8241+(1024x683).jpg" class="d-block w-100 h-100 object-fit-cover" alt="...">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100 text-center">
                <h1 class="display-2 fw-bold text-white">Bienvenido al Sistema Escolar</h1>
                <p class="fs-4 fw-bold text-white">Aprende, crece y construye tu futuro con nosotros.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/static/images/6b2bfde0-9c42-4832-8811-7b4af7d14a3d.jpg" class="d-block w-100 h-100 object-fit-cover" alt="...">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100 text-center">
                <h1 class="display-2 fw-bold text-white">Gestión Inteligente</h1>
                <p class="fs-4 fw-bold text-white">Administra estudiantes, profesores y clases en un solo lugar.</p>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/static/images/afceb2ea-513d-462d-af38-b72c1ba7ba34.jpg" class="d-block w-100 h-100 object-fit-cover" alt="...">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100 text-center">
                <h1 class="display-2 fw-bold text-white">Excelencia Académica</h1>
                <p class="fs-4 fw-bold text-white">Formamos líderes con valores y compromiso.</p>
            </div>
        </div>
    </div>

    <!-- Controles -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>


<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold" data-aos="fade-up">¿Qué puedes hacer?</h2>
        <p class="text-muted" data-aos="fade-up" data-aos-delay="100">Funciones destacadas de nuestra plataforma.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Gestión Académica</h5>
                    <p class="card-text">Administra notas, materias y docentes con facilidad.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Portal Estudiantil</h5>
                    <p class="card-text">Los alumnos pueden acceder a sus calificaciones y tareas.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="400">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Reportes en Tiempo Real</h5>
                    <p class="card-text">Obtén estadísticas académicas al instante.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-dark text-white py-5" data-aos="zoom-in">
    <div class="container text-center">
        <h2 class="mb-3">¿Listo para comenzar?</h2>
        <p class="mb-4">Regístrate y mejora la gestión educativa hoy mismo.</p>
        <a href="/Login" class="btn btn-light btn-lg px-4">Iniciar Sesión</a>
    </div>
</section>

<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold" data-aos="fade-up">Lo que dicen nuestros usuarios</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4" data-aos="fade-right">
            <blockquote class="blockquote bg-light p-4 rounded shadow-sm">
                <p>"Una plataforma intuitiva y muy útil para nuestros profesores."</p>
                <footer class="blockquote-footer">Directora, Escuela Central</footer>
            </blockquote>
        </div>
        <div class="col-md-4" data-aos="fade-up">
            <blockquote class="blockquote bg-light p-4 rounded shadow-sm">
                <p>"Ahora puedo ver mis notas y tareas desde casa. Me encanta."</p>
                <footer class="blockquote-footer">Alumno, 3° Secundaria</footer>
            </blockquote>
        </div>
        <div class="col-md-4" data-aos="fade-left">
            <blockquote class="blockquote bg-light p-4 rounded shadow-sm">
                <p>"La generación de reportes ha mejorado la toma de decisiones."</p>
                <footer class="blockquote-footer">Coordinador Académico</footer>
            </blockquote>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold" data-aos="fade-up">Nuestra Historia</h2>
        <p class="text-muted" data-aos="fade-up" data-aos-delay="100">
            Descubre los hitos que han marcado a la Escuela Carolina Dent Alvarado.
        </p>
    </div>

    <div class="timeline">
        <div class="timeline-item" data-aos="fade-right">
            <div class="timeline-content">
                <h4>1948 - Fundación</h4>
                <p>
                    Juan Dent donó el terreno para establecer una escuela en Barrio Sagrada Familia. Ese mismo año, la Junta Progresista, liderada por Santos Mora, junto a líderes comunitarios, impulsaron la escolarización masiva de los niños de sectores populares.
                </p>
            </div>
        </div>

        <div class="timeline-item" data-aos="fade-left">
            <div class="timeline-content">
                <h4>1959 - Inauguración</h4>
                <p>
                    Bajo la administración del presidente Mario Echandi Jiménez, se inauguró la moderna planta física de la escuela, consolidando el esfuerzo comunitario en pro de la educación.
                </p>
            </div>
        </div>

        <div class="timeline-item" data-aos="fade-right">
            <div class="timeline-content">
                <h4>Actualidad</h4>
                <p>
                    La Escuela Carolina Dent Alvarado continúa comprometida con la educación de calidad, adaptándose a los desafíos contemporáneos y fomentando el desarrollo integral de sus estudiantes.
                </p>
            </div>
        </div>
    </div>

    <div class="text-center mt-5" data-aos="zoom-in">
        <a href="/Historia" class="btn btn-dark btn-lg">Conoce más</a>
    </div>
</section>

<style>
    .timeline {
        position: relative;
        margin: 0 auto;
        padding: 2rem 0;
        max-width: 800px;
    }

        .timeline::after {
            content: '';
            position: absolute;
            width: 4px;
            background-color: #dee2e6;
            top: 0;
            bottom: 0;
            left: 50%;
            margin-left: -2px;
        }

    .timeline-item {
        padding: 1rem 2rem;
        position: relative;
        width: 50%;
    }

        .timeline-item:nth-child(odd) {
            left: 0;
        }

        .timeline-item:nth-child(even) {
            left: 50%;
        }

    .timeline-content {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 0.5rem;
        position: relative;
    }

        .timeline-content::after {
            content: '';
            position: absolute;
            top: 1rem;
            width: 0;
            height: 0;
            border-style: solid;
        }

    .timeline-item:nth-child(odd) .timeline-content::after {
        right: -15px;
        border-width: 10px 0 10px 15px;
        border-color: transparent transparent transparent #f8f9fa;
    }

    .timeline-item:nth-child(even) .timeline-content::after {
        left: -15px;
        border-width: 10px 15px 10px 0;
        border-color: transparent #f8f9fa transparent transparent;
    }
</style>

<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold" data-aos="fade-up">Galería Histórica</h2>
        <p class="text-muted" data-aos="fade-up" data-aos-delay="100">
            Un recorrido visual por nuestra trayectoria.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4" data-aos="zoom-in">
            <img src="~/static/images/inauguracion_1959.jpg" class="img-fluid rounded" alt="Inauguración 1959">
        </div>
        <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
            <img src="~/static/images/actividades_anteriores.jpg" class="img-fluid rounded" alt="Actividades anteriores">
        </div>
        <div class="col-md-4" data-aos="zoom-in" data-aos-delay="200">
            <img src="~/static/images/escuela_actual.jpg" class="img-fluid rounded" alt="Escuela en la actualidad">
        </div>
    </div>
</section>
